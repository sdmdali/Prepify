NODE_ENV=development
PORT=8080
DB_HOST=localhost
DB_PORT=3306
DB_NAME=prepify
DB_USER=root
DB_PASSWORD=
FRONTEND_URL=http://127.0.0.1:5500
JWT_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=1d
# One shared password hash for every admin account (generate with the command in README).
ADMIN_SHARED_PASSWORD_HASH=
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_DAILY_LIMIT=20
RESEND_API_KEY=
RESEND_FROM_EMAIL=
